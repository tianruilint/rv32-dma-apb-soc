# JSON generated by native Windows tools may use CRLF. Accept that line
# ending while retaining the normal checks for actual trailing spaces. Keep
# evidence bytes unchanged so recorded SHA-256 values remain reproducible.
*.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Matplotlib emits valid multiline SVG path attributes with spaces before
# newlines. Preserve the renderer's exact output and its evidence hash.
reports/evidence/*.svg -whitespace
# Preserve raw simulator/compiler logs.
# Their original whitespace is part of the recorded external output.
reports/p2_soc/*.log -whitespace
reports/upstream_friscv/*.log -whitespace
reports/p2_soc/system-stress/*.log -whitespace
reports/upstream_regression/**/*.log -whitespace
# Patch hunk prefixes must retain their exact leading space.
*.patch -whitespace
